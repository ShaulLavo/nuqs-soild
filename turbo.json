{
  "$schema": "https://turbo.build/schema.v2.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".tsup/**",
        ".tsbuildinfo"
      ]
    },
    "build:size-json": {
      "outputs": [
        "size.json"
      ],
      "dependsOn": [
        "build"
      ]
    },
    "test": {
      "outputs": [
        "dist/**",
        "coverage/**"
      ],
      "dependsOn": [
        "build"
      ]
    }
  }
}